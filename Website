<!-- NAV -->
<nav>
  <a href="#" class="nav-logo">NM<span>.</span></a>
  <ul class="nav-links">
    <li><a href="#projects">Projects</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="ice-lines" aria-hidden="true">
    <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <circle cx="600" cy="400" r="200" fill="none" stroke="white" stroke-width="1.5"/>
