      <line x1="600" y1="0" x2="600" y2="800" stroke="white" stroke-width="1.5"/>
      <line x1="0" y1="400" x2="1200" y2="400" stroke="white" stroke-width="0.5"/>
      <rect x="0" y="100" width="200" height="600" rx="180" fill="none" stroke="white" stroke-width="1.5"/>
      <rect x="1000" y="100" width="200" height="600" rx="180" fill="none" stroke="white" stroke-width="1.5"/>
