<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Nathan Mueller — Data Analyst</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy:    #0B1628;
    --navy2:   #111f38;
    --navy3:   #162644;
    --steel:   #4A90C4;
    --red:     #C8102E;
    --white:   #F0F4FA;
    --muted:   #7A90A8;
    --mono:    'JetBrains Mono', monospace;
    --display: 'Barlow Condensed', sans-serif;
    --body:    'Inter', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--navy);
    color: var(--white);
    font-family: var(--body);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 3rem;
    height: 60px;
    background: rgba(11,22,40,0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(74,144,196,0.15);
  }
  .nav-logo {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--white);
    text-decoration: none;
  }
  .nav-logo span { color: var(--red); }
  .nav-links { display: flex; gap: 2.5rem; list-style: none; }
  .nav-links a {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--white); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 3rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 70% 50%, rgba(74,144,196,0.08) 0%, transparent 70%),
      radial-gradient(ellipse 30% 40% at 20% 80%, rgba(200,16,46,0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  /* Ice lines background detail */
  .ice-lines {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden;
  }
  .ice-lines svg { width: 100%; height: 100%; opacity: 0.04; }

  .hero-inner { position: relative; max-width: 900px; }

  .hero-eyebrow {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--steel);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .hero-eyebrow::before {
    content: '';
    display: inline-block; width: 28px; height: 1px;
    background: var(--steel);
  }

  .hero-name {
    font-family: var(--display);
    font-size: clamp(4rem, 9vw, 7.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 0.5rem;
  }
  .hero-name .accent { color: var(--red); }

  /* Scoreboard ticker — the signature element */
  .scoreboard {
    display: inline-flex; align-items: center; gap: 1rem;
    background: var(--navy3);
    border: 1px solid rgba(74,144,196,0.3);
    border-radius: 4px;
    padding: 0.55rem 1.1rem;
    margin: 1.8rem 0 2rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--steel);
    letter-spacing: 0.06em;
  }
  .scoreboard-label {
    font-size: 0.65rem;
    color: var(--red);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .scoreboard-ticker {
    overflow: hidden; height: 1.2em;
    position: relative;
    min-width: 320px;
  }
  .ticker-track {
    display: flex; flex-direction: column;
    transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
  }
  .ticker-item { height: 1.2em; line-height: 1.2em; white-space: nowrap; }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }
  .hero-bio strong { color: var(--white); font-weight: 500; }

  .hero-cta { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }

  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.7rem 1.6rem;
    border-radius: 3px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--red);
    color: var(--white);
    border: 1px solid var(--red);
  }
  .btn-primary:hover { background: #a50d25; border-color: #a50d25; }
  .btn-ghost {
    background: transparent;
    color: var(--muted);
    border: 1px solid rgba(74,144,196,0.3);
  }
  .btn-ghost:hover { color: var(--white); border-color: var(--steel); }

  /* ── SKILLS BAR ── */
  .skills-bar {
    background: var(--navy2);
    border-top: 1px solid rgba(74,144,196,0.1);
    border-bottom: 1px solid rgba(74,144,196,0.1);
    padding: 1.2rem 3rem;
    display: flex; align-items: center; gap: 2rem; flex-wrap: wrap;
  }
  .skills-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--red);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .skills-list { display: flex; gap: 1rem; flex-wrap: wrap; }
  .skill-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--steel);
    background: rgba(74,144,196,0.1);
    border: 1px solid rgba(74,144,196,0.2);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    letter-spacing: 0.05em;
  }

  /* ── SECTIONS ── */
  section { padding: 6rem 3rem; }
  .section-eyebrow {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--red);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
    display: flex; align-items: center; gap: 0.6rem;
  }
  .section-eyebrow::after {
    content: '';
    flex: 1; max-width: 60px; height: 1px;
    background: var(--red); opacity: 0.4;
  }
  .section-title {
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.01em;
    margin-bottom: 1rem;
  }
  .section-sub {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 480px;
    font-weight: 300;
    margin-bottom: 3.5rem;
  }

  /* ── PROJECTS ── */
  #projects { background: var(--navy2); }
  .project-card {
    background: var(--navy3);
    border: 1px solid rgba(74,144,196,0.15);
    border-radius: 6px;
    padding: 2.2rem;
    transition: border-color 0.2s, transform 0.2s;
    display: flex; flex-direction: column; gap: 1.2rem;
  }
  .project-card:hover {
    border-color: rgba(74,144,196,0.4);
    transform: translateY(-2px);
  }
  .project-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .project-category {
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--red);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .project-title {
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }
  .project-links { display: flex; gap: 0.6rem; flex-shrink: 0; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    border: 1px solid rgba(74,144,196,0.25);
    border-radius: 4px;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.2s;
    font-size: 0.9rem;
  }
  .icon-btn:hover { color: var(--white); border-color: var(--steel); background: rgba(74,144,196,0.1); }
  .project-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
    font-weight: 300;
  }
  .project-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .project-tag {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--steel);
    background: rgba(74,144,196,0.08);
    border: 1px solid rgba(74,144,196,0.18);
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
  }

  /* Luck Index mini chart */
  .luck-viz {
    background: var(--navy);
    border: 1px solid rgba(74,144,196,0.12);
    border-radius: 4px;
    padding: 1.2rem;
    margin-top: 0.5rem;
  }
  .luck-viz-title {
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .luck-bars { display: flex; flex-direction: column; gap: 0.55rem; }
  .luck-row { display: flex; align-items: center; gap: 0.8rem; }
  .luck-team {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    width: 56px;
    text-align: right;
    flex-shrink: 0;
  }
  .luck-track {
    flex: 1; height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: visible;
    position: relative;
  }
  .luck-fill {
    height: 100%; border-radius: 2px;
    transition: width 1s cubic-bezier(0.4,0,0.2,1);
  }
  .luck-val {
    font-family: var(--mono);
    font-size: 0.65rem;
    width: 38px;
    flex-shrink: 0;
  }
  .luck-note {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.8rem;
    font-style: italic;
  }

  /* Add-more card */
  .project-add {
    border: 1px dashed rgba(74,144,196,0.2);
    border-radius: 6px;
    padding: 2.2rem;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
  .project-add-icon { font-size: 1.6rem; opacity: 0.3; }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  /* ── ABOUT ── */
  #about { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .about-text p { color: var(--muted); font-weight: 300; line-height: 1.8; margin-bottom: 1rem; }
  .about-text p strong { color: var(--white); font-weight: 500; }
  .about-stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(74,144,196,0.1); border: 1px solid rgba(74,144,196,0.1); border-radius: 4px; overflow: hidden; }
  .about-stat {
    background: var(--navy2);
    padding: 1.5rem;
    text-align: center;
  }
  .about-stat-num {
    font-family: var(--display);
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--white);
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .about-stat-num span { color: var(--red); }
  .about-stat-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── CONTACT ── */
  #contact { background: var(--navy2); text-align: center; }
  #contact .section-sub { margin: 0 auto 2.5rem; }
  .contact-links { display: flex; align-items: center; justify-content: center; gap: 1.2rem; flex-wrap: wrap; }
  .contact-link {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.75rem 1.8rem;
    border: 1px solid rgba(74,144,196,0.25);
    border-radius: 3px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.2s;
  }
  .contact-link:hover { color: var(--white); border-color: var(--steel); background: rgba(74,144,196,0.08); }
  .contact-link svg { width: 16px; height: 16px; }

  /* ── FOOTER ── */
  footer {
    padding: 2rem 3rem;
    border-top: 1px solid rgba(74,144,196,0.1);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
  }
  footer p { font-family: var(--mono); font-size: 0.65rem; color: var(--muted); letter-spacing: 0.05em; }

  /* ── SCROLL REVEAL ── */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  @media (max-width: 768px) {
    nav { padding: 0 1.5rem; }
    .nav-links { display: none; }
    .hero, section { padding: 5rem 1.5rem; }
    #about { grid-template-columns: 1fr; gap: 3rem; }
    .skills-bar { padding: 1.2rem 1.5rem; }
    footer { padding: 2rem 1.5rem; }
    .scoreboard-ticker { min-width: 200px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; }
    .luck-fill { transition: none; }
  }
</style>
</head>
