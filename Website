<script>
  // Ticker
  const items = document.querySelectorAll('.ticker-item');
  const track = document.getElementById('ticker');
  let current = 0;
  setInterval(() => {
    current = (current + 1) % items.length;
    track.style.transform = `translateY(-${current * 1.2}em)`;
  }, 2800);

  // Scroll reveal
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  reveals.forEach(el => observer.observe(el));

  // Animate luck bars on scroll
  const barsEl = document.getElementById('luckBars');
  const barsObserver = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      document.querySelectorAll('.luck-fill').forEach(bar => {
        bar.style.width = bar.dataset.w;
        bar.style.background = bar.dataset.color;
      });
      barsObserver.unobserve(barsEl);
    }
  }, { threshold: 0.3 });
  if (barsEl) barsObserver.observe(barsEl);
</script>
