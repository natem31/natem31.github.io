    <span class="skill-tag">SQL</span>
    <span class="skill-tag">Tableau</span>
  </div>
</div>

<!-- PROJECTS -->
<section id="projects">
  <p class="section-eyebrow reveal">Work</p>
  <h2 class="section-title reveal">Projects</h2>
  <p class="section-sub reveal">Analytical deep-dives into the data stories worth telling.</p>

  <div class="projects-grid">

    <!-- PROJECT 1 -->
    <div class="project-card reveal">
      <div class="project-header">
        <div>
          <p class="project-category">Hockey Analytics</p>
          <h3 class="project-title">Luck in NHL Standings</h3>
        </div>
        <div class="project-links">
          <a href="https://github.com/natem31/NHL-Luck-in-Standings" target="_blank" rel="noopener" class="icon-btn" title="View on GitHub">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          </a>
        </div>
